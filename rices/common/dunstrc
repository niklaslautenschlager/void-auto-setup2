# @@name@@ rice: dunst (generated by void-rice, edit palettes/@@rice@@.conf instead)
[global]
    monitor = 0
    follow = mouse
    width = 360
    height = (0, 300)
    origin = top-right
    offset = (14, @@bar_h@@)
    notification_limit = 6
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_corner_radius = @@radius_small@@
    indicate_hidden = yes
    padding = 12
    horizontal_padding = 16
    text_icon_padding = 12
    frame_width = @@border@@
    frame_color = "@@accent@@"
    gap_size = 8
    separator_color = frame
    sort = yes
    font = @@font_ui@@ @@font_size@@
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    icon_theme = Papirus-Dark
    enable_recursive_icon_lookup = true
    icon_position = left
    max_icon_size = 48
    corner_radius = @@radius@@
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    background = "@@bg_alt@@"
    foreground = "@@fg_dim@@"
    frame_color = "@@bg_hi@@"
    highlight = "@@fg_dim@@"
    timeout = 5

[urgency_normal]
    background = "@@bg_alt@@"
    foreground = "@@fg@@"
    highlight = "@@accent@@"
    timeout = 8

[urgency_critical]
    background = "@@bg_alt@@"
    foreground = "@@fg@@"
    frame_color = "@@urgent@@"
    highlight = "@@urgent@@"
    timeout = 0

[rice_osd]
    appname = rice
    frame_color = "@@accent2@@"
    format = "<b>%s</b>"
