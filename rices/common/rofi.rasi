/* @@name@@ rice: rofi (generated by void-rice, edit palettes/@@rice@@.conf instead) */
configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "apps";
    display-run: "run";
    display-window: "windows";
    drun-display-format: "{name}";
    font: "@@font_ui@@ @@font_size@@";
}

* {
    bg:      @@bg@@;
    bg-alt:  @@bg_alt@@;
    bg-hi:   @@bg_hi@@;
    fg:      @@fg@@;
    fg-dim:  @@fg_dim@@;
    accent:  @@accent@@;
    urgent:  @@urgent@@;
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 620px;
    background-color: @bg;
    border: @@border@@px;
    border-color: @accent;
    border-radius: @@radius@@px;
    padding: 18px;
}

mainbox {
    spacing: 14px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border-radius: @@radius@@px;
    padding: 10px 14px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "type to search";
    placeholder-color: @fg-dim;
    cursor: text;
}

listview {
    lines: 8;
    columns: 1;
    spacing: 4px;
    scrollbar: false;
    fixed-height: false;
    dynamic: true;
}

element {
    padding: 8px 12px;
    border-radius: @@radius@@px;
    spacing: 12px;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @bg-hi;
    text-color: @accent;
}

element normal.urgent, element selected.urgent {
    text-color: @urgent;
}

element-icon {
    size: 22px;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}
