// @@name@@ rice: shared Waybar modules (generated by void-rice)
{
    "custom/void": {
        "format": "@@i_void@@",
        "tooltip": false,
        "on-click": "rice launch"
    },
    "clock": {
        "format": "@@i_clock@@  {:%H:%M}",
        "format-alt": "@@i_cal@@  {:%A, %d %B %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "format": "@@i_cpu@@ {usage}%",
        "interval": 5,
        "on-click": "rice term htop"
    },
    "memory": {
        "format": "@@i_mem@@ {percentage}%",
        "interval": 10
    },
    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "@@i_vol_off@@ muted",
        "format-icons": ["@@i_vol_lo@@", "@@i_vol_mid@@", "@@i_vol_hi@@"],
        "max-volume": 100,
        "on-click": "pavucontrol",
        "on-click-right": "rice vol mute",
        "on-scroll-up": "rice vol up",
        "on-scroll-down": "rice vol down"
    },
    "network": {
        "format-wifi": "@@i_wifi@@ {essid}",
        "format-ethernet": "@@i_eth@@ wired",
        "format-disconnected": "@@i_net_off@@ offline",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "rice term nmtui"
    },
    "battery": {
        "states": { "warning": 25, "critical": 12 },
        "format": "{icon} {capacity}%",
        "format-charging": "@@i_bat_chg@@ {capacity}%",
        "format-icons": ["@@i_bat_0@@", "@@i_bat_1@@", "@@i_bat_2@@", "@@i_bat_3@@", "@@i_bat_4@@"]
    },
    "backlight": {
        "format": "@@i_light@@ {percent}%",
        "on-scroll-up": "rice light up",
        "on-scroll-down": "rice light down"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "@@i_eye@@", "deactivated": "@@i_eye_off@@" },
        "tooltip-format-activated": "screen stays on",
        "tooltip-format-deactivated": "idle lock active"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "custom/power": {
        "format": "@@i_power@@",
        "tooltip": false,
        "on-click": "rice power"
    }
}
