// @@name@@: Waybar for MangoWC (generated by void-rice)
// Upstream Waybar has no mango/* modules; mango implements ext-workspace,
// so the generic ext/workspaces module shows its tags.
{
    "include": ["@@rice_dir@@/waybar/modules.jsonc"],
    "layer": "top",
    "position": "@@bar_pos@@",
    "height": @@bar_h@@,
    "margin-top": @@bar_margin@@,
    "margin-left": @@bar_margin@@,
    "margin-right": @@bar_margin@@,
    "spacing": 0,
    "modules-left": ["custom/void", "ext/workspaces", "wlr/taskbar"],
    "modules-center": ["clock"],
    "modules-right": ["idle_inhibitor", "wireplumber", "backlight", "network", "cpu", "memory", "battery", "tray", "custom/power"],
    "ext/workspaces": {
        "format": "{name}",
        "sort-by-id": true,
        "on-click": "activate",
        "ignore-hidden": true
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 16,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close"
    }
}
