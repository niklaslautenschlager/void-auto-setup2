(
    modkey: "Mod4",
    mousekey: "Mod4",
    focus_behaviour: Driven,
    keybind: [
        (command: Execute, value: "rice term", modifier: ["modkey"], key: "Return"),
        (command: Execute, value: "rice launch", modifier: ["modkey"], key: "d"),
        (command: Execute, value: "rice launch", modifier: ["modkey"], key: "space"),
        (command: CloseWindow, modifier: ["modkey"], key: "q"),
        (command: ToggleFullScreen, modifier: ["modkey"], key: "f"),
        (command: ToggleFloating, modifier: ["modkey"], key: "v"),
        (command: FocusWindowAt, value: "left", modifier: ["modkey"], key: "h"),
        (command: FocusWindowAt, value: "down", modifier: ["modkey"], key: "j"),
        (command: FocusWindowAt, value: "up", modifier: ["modkey"], key: "k"),
        (command: FocusWindowAt, value: "right", modifier: ["modkey"], key: "l"),
        (command: FocusWindowAt, value: "left", modifier: ["modkey"], key: "Left"),
        (command: FocusWindowAt, value: "down", modifier: ["modkey"], key: "Down"),
        (command: FocusWindowAt, value: "up", modifier: ["modkey"], key: "Up"),
        (command: FocusWindowAt, value: "right", modifier: ["modkey"], key: "Right"),
        (command: MoveWindowAt, value: "left", modifier: ["modkey", "Shift"], key: "h"),
        (command: MoveWindowAt, value: "down", modifier: ["modkey", "Shift"], key: "j"),
        (command: MoveWindowAt, value: "up", modifier: ["modkey", "Shift"], key: "k"),
        (command: MoveWindowAt, value: "right", modifier: ["modkey", "Shift"], key: "l"),
        (command: MoveWindowAt, value: "left", modifier: ["modkey", "Shift"], key: "Left"),
        (command: MoveWindowAt, value: "down", modifier: ["modkey", "Shift"], key: "Down"),
        (command: MoveWindowAt, value: "up", modifier: ["modkey", "Shift"], key: "Up"),
        (command: MoveWindowAt, value: "right", modifier: ["modkey", "Shift"], key: "Right"),
        (command: DecreaseMainSize, modifier: ["modkey", "Control"], key: "h"),
        (command: IncreaseMainSize, modifier: ["modkey", "Control"], key: "l"),
        (command: Execute, value: "rice lock", modifier: ["modkey"], key: "Escape"),
        (command: Execute, value: "rice power", modifier: ["modkey", "Shift"], key: "Escape"),
        (command: SoftReload, modifier: ["modkey", "Shift"], key: "r"),
        (command: Execute, value: "rice shot full", modifier: [], key: "Print"),
        (command: Execute, value: "rice shot area", modifier: ["Shift"], key: "Print"),
        (command: Execute, value: "rice vol up", modifier: [], key: "XF86AudioRaiseVolume"),
        (command: Execute, value: "rice vol down", modifier: [], key: "XF86AudioLowerVolume"),
        (command: Execute, value: "rice vol mute", modifier: [], key: "XF86AudioMute"),
        (command: Execute, value: "rice vol mic", modifier: [], key: "XF86AudioMicMute"),
        (command: Execute, value: "rice light up", modifier: [], key: "XF86MonBrightnessUp"),
        (command: Execute, value: "rice light down", modifier: [], key: "XF86MonBrightnessDown"),
        (command: Execute, value: "playerctl play-pause", modifier: [], key: "XF86AudioPlay"),
        (command: Execute, value: "playerctl next", modifier: [], key: "XF86AudioNext"),
        (command: Execute, value: "playerctl previous", modifier: [], key: "XF86AudioPrev"),
        (command: GotoTag, value: "1", modifier: ["modkey"], key: "1"),
        (command: GotoTag, value: "2", modifier: ["modkey"], key: "2"),
        (command: GotoTag, value: "3", modifier: ["modkey"], key: "3"),
        (command: GotoTag, value: "4", modifier: ["modkey"], key: "4"),
        (command: GotoTag, value: "5", modifier: ["modkey"], key: "5"),
        (command: GotoTag, value: "6", modifier: ["modkey"], key: "6"),
        (command: GotoTag, value: "7", modifier: ["modkey"], key: "7"),
        (command: GotoTag, value: "8", modifier: ["modkey"], key: "8"),
        (command: GotoTag, value: "9", modifier: ["modkey"], key: "9"),
        (command: MoveToTag, value: "1", modifier: ["modkey", "Shift"], key: "1"),
        (command: MoveToTag, value: "2", modifier: ["modkey", "Shift"], key: "2"),
        (command: MoveToTag, value: "3", modifier: ["modkey", "Shift"], key: "3"),
        (command: MoveToTag, value: "4", modifier: ["modkey", "Shift"], key: "4"),
        (command: MoveToTag, value: "5", modifier: ["modkey", "Shift"], key: "5"),
        (command: MoveToTag, value: "6", modifier: ["modkey", "Shift"], key: "6"),
        (command: MoveToTag, value: "7", modifier: ["modkey", "Shift"], key: "7"),
        (command: MoveToTag, value: "8", modifier: ["modkey", "Shift"], key: "8"),
        (command: MoveToTag, value: "9", modifier: ["modkey", "Shift"], key: "9"),
    ],
)
