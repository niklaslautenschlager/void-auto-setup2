// @@name@@: Waybar for River (generated by void-rice)
{
    "include": ["@@rice_dir@@/waybar/modules.jsonc"],
    "layer": "top",
    "position": "@@bar_pos@@",
    "height": @@bar_h@@,
    "margin-bottom": @@bar_margin@@,
    "margin-left": @@bar_margin@@,
    "margin-right": @@bar_margin@@,
    "spacing": 0,
    "modules-left": ["custom/void", "river/tags", "river/mode", "river/window"],
    "modules-center": ["clock"],
    "modules-right": ["idle_inhibitor", "wireplumber", "backlight", "network", "cpu", "memory", "battery", "tray", "custom/power"],
    "river/tags": {
        "num-tags": 9,
        "hide-vacant": true
    },
    "river/window": {
        "max-length": 48
    }
}
