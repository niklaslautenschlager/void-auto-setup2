#!/bin/sh
# @@name@@: River rice (void-postinstall)
# Generated by void-rice from palettes/@@rice@@.conf. Edit the palette (or
# ~/.config/void-rice/@@rice@@.conf) and run `void-rice apply @@rice@@`.
# River 0.3 has no built-in bindings: this file IS the configuration.

# ---- look ----------------------------------------------------------------
riverctl background-color 0x@@bg_hex@@
riverctl border-color-focused 0x@@accent_hex@@
riverctl border-color-unfocused 0x@@bg_hi_hex@@
riverctl border-color-urgent 0x@@urgent_hex@@
riverctl border-width @@border@@

# ---- input -------------------------------------------------------------------
riverctl keyboard-layout @@kb_layout@@
riverctl set-repeat 40 300
riverctl focus-follows-cursor normal
riverctl set-cursor-warp on-output-change
riverctl hide-cursor when-typing enabled
for pad in '*Touchpad' '*touchpad'; do
    riverctl input "$pad" tap enabled
    riverctl input "$pad" natural-scroll enabled
    riverctl input "$pad" disable-while-typing enabled
done

# ---- keys (same layout in every void-postinstall rice) ------------------------
riverctl map normal Super Return spawn 'rice term'
riverctl map normal Super D spawn 'rice launch'
riverctl map normal Super Space spawn 'rice launch'
riverctl map normal Super Q close
riverctl map normal Super F toggle-fullscreen
riverctl map normal Super V toggle-float
riverctl map normal Super Escape spawn 'rice lock'
riverctl map normal Super+Shift Escape spawn 'rice power'
riverctl map normal Super+Shift R spawn "$HOME/.config/river/init"
riverctl map normal None Print spawn 'rice shot full'
riverctl map normal Shift Print spawn 'rice shot area'
riverctl map normal Super+Shift Return zoom

for pair in "H left" "J down" "K up" "L right" "Left left" "Down down" "Up up" "Right right"; do
    set -- $pair
    riverctl map normal Super "$1" focus-view "$2"
    riverctl map normal Super+Shift "$1" swap "$2"
done
# main area size / count (rivertile)
riverctl map -repeat normal Super+Control H send-layout-cmd rivertile "main-ratio -0.05"
riverctl map -repeat normal Super+Control L send-layout-cmd rivertile "main-ratio +0.05"
riverctl map normal Super+Control K send-layout-cmd rivertile "main-count +1"
riverctl map normal Super+Control J send-layout-cmd rivertile "main-count -1"
riverctl map normal Super+Alt Up    send-layout-cmd rivertile "main-location top"
riverctl map normal Super+Alt Right send-layout-cmd rivertile "main-location right"
riverctl map normal Super+Alt Down  send-layout-cmd rivertile "main-location bottom"
riverctl map normal Super+Alt Left  send-layout-cmd rivertile "main-location left"

riverctl map-pointer normal Super BTN_LEFT move-view
riverctl map-pointer normal Super BTN_RIGHT resize-view
riverctl map-pointer normal Super BTN_MIDDLE toggle-float

for i in 1 2 3 4 5 6 7 8 9; do
    tags=$((1 << (i - 1)))
    riverctl map normal Super "$i" set-focused-tags $tags
    riverctl map normal Super+Shift "$i" set-view-tags $tags
    riverctl map normal Super+Control "$i" toggle-focused-tags $tags
    riverctl map normal Super+Shift+Control "$i" toggle-view-tags $tags
done
all_tags=$(((1 << 32) - 1))
riverctl map normal Super 0 set-focused-tags $all_tags
riverctl map normal Super+Shift 0 set-view-tags $all_tags
riverctl map normal Super Tab focus-previous-tags

for mode in normal locked; do
    riverctl map -repeat $mode None XF86AudioRaiseVolume spawn 'rice vol up'
    riverctl map -repeat $mode None XF86AudioLowerVolume spawn 'rice vol down'
    riverctl map $mode None XF86AudioMute spawn 'rice vol mute'
    riverctl map $mode None XF86AudioMicMute spawn 'rice vol mic'
    riverctl map -repeat $mode None XF86MonBrightnessUp spawn 'rice light up'
    riverctl map -repeat $mode None XF86MonBrightnessDown spawn 'rice light down'
    riverctl map $mode None XF86AudioPlay spawn 'playerctl play-pause'
    riverctl map $mode None XF86AudioPause spawn 'playerctl play-pause'
    riverctl map $mode None XF86AudioNext spawn 'playerctl next'
    riverctl map $mode None XF86AudioPrev spawn 'playerctl previous'
done

# passthrough mode for nested sessions / VMs
riverctl declare-mode passthrough
riverctl map normal Super F11 enter-mode passthrough
riverctl map passthrough Super F11 enter-mode normal

# ---- rules ---------------------------------------------------------------------
riverctl rule-add -app-id 'pavucontrol' float
riverctl rule-add -app-id 'org.pulseaudio.pavucontrol' float
riverctl rule-add -app-id 'nm-connection-editor' float
riverctl rule-add -app-id 'blueman-manager' float
riverctl rule-add ssd

# ---- layout ------------------------------------------------------------------------
riverctl default-layout rivertile
pkill -u "$(id -u)" -x rivertile 2>/dev/null
rivertile -view-padding @@gaps_in@@ -outer-padding @@gaps_out@@ -main-ratio 0.55 &

# ---- session -----------------------------------------------------------------------
# Waybar, mako, swaybg, swayidle, polkit agent, applets, D-Bus activation env.
# PipeWire is already running (void-session).
# (re-running this file on reload restarts bar/notifications/wallpaper; the
# rest is started only once)
riverctl spawn 'rice autostart'
