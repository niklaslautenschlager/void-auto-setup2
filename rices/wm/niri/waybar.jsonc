// @@name@@: Waybar for niri (generated by void-rice)
{
    "include": ["@@rice_dir@@/waybar/modules.jsonc"],
    "layer": "top",
    "position": "@@bar_pos@@",
    "height": @@bar_h@@,
    "margin-top": @@bar_margin@@,
    "margin-left": @@bar_margin@@,
    "margin-right": @@bar_margin@@,
    "spacing": 4,
    "modules-left": ["custom/void", "niri/workspaces", "niri/window"],
    "modules-center": ["clock"],
    "modules-right": ["idle_inhibitor", "wireplumber", "backlight", "network", "cpu", "memory", "battery", "tray", "custom/power"],
    "niri/workspaces": {
        "format": "{index}"
    },
    "niri/window": {
        "max-length": 48
    }
}
