# @@name@@: Sway rice (void-postinstall)
# Generated by void-rice from palettes/@@rice@@.conf. Edit the palette (or
# ~/.config/void-rice/@@rice@@.conf) and run `void-rice apply @@rice@@`.

set $mod Mod4
set $left h
set $down j
set $up k
set $right l

# ---- look ---------------------------------------------------------------
font pango:@@font_ui@@ @@font_size@@
default_border pixel @@border@@
default_floating_border pixel @@border@@
titlebar_padding 6 3
gaps inner @@gaps_in@@
gaps outer @@gaps_out@@
smart_borders on

#                       border        background    text      indicator     child_border
client.focused          @@accent@@    @@accent@@    @@bg@@    @@accent2@@   @@accent@@
client.focused_inactive @@bg_hi@@     @@bg_hi@@     @@fg@@    @@bg_hi@@     @@bg_hi@@
client.unfocused        @@bg_alt@@    @@bg_alt@@    @@fg_dim@@ @@bg_alt@@   @@bg_hi@@
client.urgent           @@urgent@@    @@urgent@@    @@bg@@    @@urgent@@    @@urgent@@

# ---- input ----------------------------------------------------------------
input type:keyboard {
    xkb_layout @@kb_layout@@
    repeat_delay 300
    repeat_rate 40
}
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

# ---- session --------------------------------------------------------------
# Waybar, mako, swaybg, swayidle, polkit agent, applets, D-Bus activation env.
# PipeWire is already running (void-session), so it is not started here.
exec rice autostart

# ---- keys (same layout in every void-postinstall rice) ----------------------
bindsym $mod+Return exec rice term
bindsym $mod+d exec rice launch
bindsym $mod+space exec rice launch
bindsym $mod+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+v floating toggle
bindsym $mod+Shift+v focus mode_toggle
bindsym $mod+Escape exec rice lock
bindsym $mod+Shift+Escape exec rice power
bindsym $mod+Shift+r reload
bindsym Print exec rice shot full
bindsym Shift+Print exec rice shot area
floating_modifier $mod normal

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+Ctrl+$left resize shrink width 40px
bindsym $mod+Ctrl+$down resize grow height 40px
bindsym $mod+Ctrl+$up resize shrink height 40px
bindsym $mod+Ctrl+$right resize grow width 40px

bindsym $mod+b splith
bindsym $mod+n splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+a focus parent

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10
bindsym $mod+Tab workspace back_and_forth

bindsym $mod+Shift+grave move scratchpad
bindsym $mod+grave scratchpad show

bindsym --locked XF86AudioRaiseVolume exec rice vol up
bindsym --locked XF86AudioLowerVolume exec rice vol down
bindsym --locked XF86AudioMute exec rice vol mute
bindsym --locked XF86AudioMicMute exec rice vol mic
bindsym --locked XF86MonBrightnessUp exec rice light up
bindsym --locked XF86MonBrightnessDown exec rice light down
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous

# ---- rules ------------------------------------------------------------------
for_window [app_id="^(pavucontrol|org.pulseaudio.pavucontrol|nm-connection-editor|blueman-manager)$"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_type="dialog"] floating enable

include /etc/sway/config.d/*
