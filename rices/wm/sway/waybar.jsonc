// @@name@@: Waybar for Sway (generated by void-rice)
{
    "include": ["@@rice_dir@@/waybar/modules.jsonc"],
    "layer": "top",
    "position": "@@bar_pos@@",
    "height": @@bar_h@@,
    "margin-top": @@bar_margin@@,
    "margin-left": @@bar_margin@@,
    "margin-right": @@bar_margin@@,
    "spacing": 0,
    "modules-left": ["custom/void", "sway/workspaces", "sway/mode", "sway/window"],
    "modules-center": ["clock"],
    "modules-right": ["idle_inhibitor", "wireplumber", "backlight", "network", "cpu", "memory", "battery", "tray", "custom/power"],
    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },
    "sway/window": {
        "max-length": 48
    }
}
