#!/bin/sh
# void-audio-check: diagnose PipeWire in the current session.
# Run it as your normal user inside the graphical session.

ok=0 bad=0
pass() { printf '\033[1;32m  ok\033[0m  %s\n' "$*"; ok=$((ok + 1)); }
fail() { printf '\033[1;31mFAIL\033[0m  %s\n' "$1"; [ -n "${2:-}" ] && printf '        fix: %s\n' "$2"; bad=$((bad + 1)); }
note() { printf '\033[1;33minfo\033[0m  %s\n' "$*"; }
count() { pgrep -u "$(id -u)" -x "$1" 2>/dev/null | wc -l; }

[ "$(id -u)" -eq 0 ] && echo "Run this as your normal user, not root." && exit 2
echo "PipeWire check for $(id -un), session type: ${XDG_SESSION_TYPE:-unknown}"
echo

# --- prerequisites (handbook: PipeWire > Prerequisites) -----------------------
if [ -S /run/dbus/system_bus_socket ]; then pass "system D-Bus is running"
else fail "system D-Bus is not running" "sudo ln -s /etc/sv/dbus /var/service/ && reboot"; fi

if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] && [ -O "$XDG_RUNTIME_DIR" ]; then
  pass "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
else
  fail "XDG_RUNTIME_DIR missing or not yours" "use elogind, or install dumb_runtime_dir (seatd setups), then log in again"
fi

if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && dbus-send --session --dest=org.freedesktop.DBus --type=method_call --print-reply / org.freedesktop.DBus.Peer.Ping >/dev/null 2>&1; then
  pass "D-Bus session bus reachable"
else
  fail "no working D-Bus session bus" "start your WM through void-session (or dbus-run-session)"
fi

if [ -d /run/systemd/seats ] || pgrep -x elogind-daemon >/dev/null 2>&1 || pgrep -x elogind >/dev/null 2>&1; then
  pass "elogind manages device access"
else
  if id -nG | tr ' ' '\n' | grep -qx audio && id -nG | tr ' ' '\n' | grep -qx video; then
    pass "no elogind, but you are in the audio and video groups"
  else
    fail "no elogind and not in audio+video groups (handbook requirement)" "sudo usermod -aG audio,video $(id -un), then log in again"
  fi
fi

# --- configuration -------------------------------------------------------------
for f in /etc/pipewire/pipewire.conf.d/10-wireplumber.conf /etc/pipewire/pipewire.conf.d/20-pipewire-pulse.conf; do
  if [ -e "$f" ]; then pass "$(basename "$f") present"
  else fail "$f missing" "sudo ln -sf /usr/share/examples/$( [ "${f##*/}" = 10-wireplumber.conf ] && echo wireplumber || echo pipewire )/${f##*/} /etc/pipewire/pipewire.conf.d/"; fi
done
if [ -e /etc/alsa/conf.d/99-pipewire-default.conf ]; then pass "ALSA apps are routed through PipeWire"
else note "ALSA routing not configured (install alsa-pipewire, link 50-/99-pipewire*.conf into /etc/alsa/conf.d)"; fi

# --- processes -------------------------------------------------------------------
for p in pipewire wireplumber pipewire-pulse; do
  n=$(count "$p")
  case "$n" in
    1) pass "$p running (1 instance)" ;;
    0) fail "$p is not running" "void-pipewire --bg   (or log out and back in)" ;;
    *) fail "$p is running $n times" "void-pipewire --bg   restarts a single clean stack" ;;
  esac
done
if pgrep -u "$(id -u)" -x pulseaudio >/dev/null 2>&1; then
  fail "PulseAudio is running and fights pipewire-pulse" "pulseaudio -k; sudo xbps-remove pulseaudio"
fi

# --- devices ---------------------------------------------------------------------
if grep -q '[0-9] \[' /proc/asound/cards 2>/dev/null; then
  pass "kernel sees sound card(s): $(sed -n 's/^ *[0-9]* \[\([^]]*\)\].*/\1/p' /proc/asound/cards | tr -s ' \n' ' ')"
else
  fail "the kernel sees no sound card" "Intel/AMD laptops need: sudo xbps-install sof-firmware alsa-ucm-conf, then reboot"
fi

if command -v pactl >/dev/null 2>&1; then
  srv="$(pactl info 2>/dev/null | sed -n 's/^Server Name: //p')"
  case "$srv" in
    *PipeWire*) pass "PulseAudio clients talk to: $srv" ;;
    "") fail "pactl cannot reach a sound server" "check pipewire-pulse above" ;;
    *) fail "pactl reports '$srv' instead of PipeWire" "remove pulseaudio" ;;
  esac
fi

if command -v wpctl >/dev/null 2>&1; then
  sink="$(wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null | sed -n 's/.*node.description = "\(.*\)"/\1/p' | head -n1)"
  case "$sink" in
    "") fail "no default output device" "wpctl status: check for 'Dummy Output'; see device lines above" ;;
    *Dummy*) fail "only a dummy output exists" "session manager or device permissions; see FAILs above" ;;
    *) pass "default output: $sink ($(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null))" ;;
  esac
fi

if [ -d /usr/lib/spa-0.2/bluez5 ]; then
  if pgrep -x bluetoothd >/dev/null 2>&1; then pass "Bluetooth audio available (bluetoothd + libspa-bluetooth)"
  else note "libspa-bluetooth installed but bluetoothd not running"; fi
fi

echo
printf '%s passed, %s failed. ' "$ok" "$bad"
[ -r "${XDG_RUNTIME_DIR:-/nonexistent}/void-pipewire.log" ] && printf 'Log: %s' "$XDG_RUNTIME_DIR/void-pipewire.log"
echo
[ "$bad" -eq 0 ]
