#!/bin/bash
# void-update: a shlib-safe `xbps-install -Su` for Void systems that also use
# a third-party repository such as hyprland-void.
#
# The problem: third-party binaries are linked against specific sonames of
# Void's libraries (libre2.so.11, libglslang.so.16, libjxl.so.0.12, Qt's
# private API, ...). When Void bumps one of them before the third-party repo
# rebuilds, xbps refuses the *entire* system update:
#
#   aquamarine-0.15.0_1: broken, unresolvable shlib `libdisplay-info.so.2'
#   Transaction aborted due to unresolved shlibs.
#
# What this does instead:
#   1. releases the holds it placed last time (so packages catch up as soon
#      as the third-party repo has rebuilt),
#   2. syncs and updates xbps itself first (handbook: separate transaction),
#   3. dry-runs the update and, for every unresolvable shlib, *holds* the
#      package whose update would cause it, then retries until the
#      transaction is clean. Holds only what's needed, nothing else,
#   4. runs the real update, remembers its holds in $STATE,
#   5. repolocks everything installed from a third-party repo, so a package
#      that exists in both repos (hyprutils, hyprpicker, lua55...) can never
#      silently switch origin.
#
# Usage: void-update [-n|--dry-run] [-y|--yes] [--status] [--release] [--no-sync]

set -uo pipefail

STATE_DIR=/var/lib/void-update
STATE="$STATE_DIR/held"
CONF=/etc/void-update.conf
MAX_ROUNDS=15

# Repositories treated as third-party (substring of the repository URL).
THIRD_PARTY="hyprland-void"
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

DRY=0 YES=0 SYNC=1 MODE=update
for a in "$@"; do
  case "$a" in
    -n|--dry-run) DRY=1 ;;
    -y|--yes)     YES=1 ;;
    --no-sync)    SYNC=0 ;;
    --status)     MODE=status ;;
    --release)    MODE=release ;;
    -h|--help)    sed -n '2,27p' "$0"; exit 0 ;;
    *) echo "unknown option: $a" >&2; exit 2 ;;
  esac
done

b() { printf '\033[1m%s\033[0m\n' "$*"; }
say() { printf '\033[1;34m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }

[ "$(id -u)" -eq 0 ] || { echo "void-update must run as root" >&2; exit 1; }

if [ "$DRY" = 0 ]; then
  mkdir -p "$STATE_DIR"
  touch "$STATE"
fi

pkgname() { local v="$1"; printf '%s' "${v%-*}"; }
installed_ver() { xbps-query -p pkgver "$1" 2>/dev/null; }
is_held() { xbps-query -H 2>/dev/null | sed 's/-[^-]*$//' | grep -qxF -- "$1"; }

# ---------------------------------------------------------------------------
status() {
  b "Holds placed by void-update:"
  if [ -s "$STATE" ]; then sed 's/^/  /' "$STATE"; else echo "  (none)"; fi
  b "All held packages:"
  xbps-query -H 2>/dev/null | sed 's/^/  /' || true
  b "Repolocked packages:"
  xbps-query --list-repolock-pkgs 2>/dev/null | sed 's/^/  /' || true
}

release() {
  local p
  [ -s "$STATE" ] || return 0
  while read -r p; do
    [ -n "$p" ] || continue
    if [ "$DRY" = 1 ]; then echo "  would unhold $p"; else xbps-pkgdb -m unhold "$p" >/dev/null 2>&1 || true; fi
  done <"$STATE"
  [ "$DRY" = 1 ] || : >"$STATE"
  say "released previous holds"
}

# hold PKG REASON: hold for this run, remember it (never touches user holds)
declare -A HELD_NOW=()
hold() {
  local p="$1" why="$2"
  [ -n "${HELD_NOW[$p]:-}" ] && return 1
  if is_held "$p" && ! grep -qx "$p" "$STATE"; then
    return 1                     # held by the admin: not ours to manage
  fi
  HELD_NOW[$p]="$why"
  if [ "$DRY" = 1 ]; then
    printf '  would hold %-24s %s\n' "$p" "$why"
    return 0
  fi
  xbps-pkgdb -m hold "$p" >/dev/null 2>&1 || return 1
  grep -qx "$p" "$STATE" || echo "$p" >>"$STATE"
  printf '  hold %-28s %s\n' "$p" "$why"
  return 0
}

# installed package(s) that currently provide a shlib
shlib_providers() {
  local re
  re="^$(printf '%s' "$1" | sed 's/[][\.^$*+?(){}|/]/\\&/g')\$"
  xbps-query --regex -p shlib-provides -s "$re" 2>/dev/null | sed 's/:.*//; s/-[^-]*$//' | sort -u
}

# installed reverse dependencies of PKG that have an update pending
revdeps_with_updates() {
  local r inst repo
  for r in $(xbps-query -X "$1" 2>/dev/null | sed 's/-[^-]*$//'); do
    [ -n "$r" ] || continue
    inst="$(installed_ver "$r")"
    repo="$(xbps-query -R -p pkgver "$r" 2>/dev/null)"
    [ -n "$repo" ] && [ "$repo" != "$inst" ] && echo "$r"
  done
}

# One dry-run round. Returns 0 when the transaction is clean.
resolve_round() {
  local out line pv shlib name provider changed=0 dep
  out="$(xbps-install -un 2>&1)"
  if ! grep -qE "unresolvable shlib|Transaction aborted" <<<"$out"; then
    return 0
  fi

  while IFS= read -r line; do
    if [[ "$line" =~ ^(.+):\ broken,\ unresolvable\ shlib\ \`(.+)\'$ ]]; then
      pv="${BASH_REMATCH[1]}" shlib="${BASH_REMATCH[2]}"
      name="$(pkgname "$pv")"
      if [ "$(installed_ver "$name")" = "$pv" ]; then
        # an installed package (typically third-party) would lose $shlib:
        # freeze whatever provides it now
        while read -r provider; do
          [ -n "$provider" ] && hold "$provider" "would drop $shlib needed by $pv" && changed=1
        done < <(shlib_providers "$shlib")
      elif [ -n "$(installed_ver "$name")" ]; then
        # the *new* version of $name needs a shlib that isn't available
        hold "$name" "update needs $shlib (not available)" && changed=1
      else
        warn "new dependency $pv needs missing $shlib. Not holdable, needs manual review"
      fi
    elif [[ "$line" =~ ^([A-Za-z0-9._+-]+)(\>=|\<=|\>|\<|=)[^[:space:]]+$ ]]; then
      # missing dependency pattern, caused by one of our holds
      dep="${BASH_REMATCH[1]}"
      if [ -n "${HELD_NOW[$dep]:-}" ] || grep -qx "$dep" "$STATE"; then
        while read -r name; do
          [ -n "$name" ] && hold "$name" "needs newer $dep (held)" && changed=1
        done < <(revdeps_with_updates "$dep")
      fi
    fi
  done <<<"$out"

  if [ "$changed" = 0 ]; then
    warn "xbps still refuses the update and nothing more can be held safely:"
    grep -vE '^\s*$' <<<"$out" | tail -n 15 >&2
    return 2
  fi
  return 1
}

relock_third_party() {
  local pat v p n=0
  for pat in $THIRD_PARTY; do
    while read -r v; do
      p="$(pkgname "${v%%:*}")"
      [ -n "$p" ] || continue
      if [ "$DRY" = 1 ]; then echo "  would repolock $p"; else xbps-pkgdb -m repolock "$p" >/dev/null 2>&1 && n=$((n + 1)); fi
    done < <(xbps-query -p repository -s "$pat" 2>/dev/null)
  done
  [ "$n" -gt 0 ] && say "repolocked $n package(s) from third-party repos ($THIRD_PARTY)"
  return 0
}

# ---------------------------------------------------------------------------
case "$MODE" in
  status)  status; exit 0 ;;
  release) release; exit 0 ;;
esac

if [ "$DRY" = 1 ]; then
  [ ! -s "$STATE" ] || say "preview keeps existing void-update holds in place"
else
  release
fi

if [ "$SYNC" = 1 ]; then
  say "syncing repositories"
  xbps-install -S </dev/null || { warn "sync failed (network? key?)"; exit 1; }
fi

# xbps updates itself in its own transaction
if xbps-install -un xbps 2>/dev/null | grep -q '^xbps-'; then
  say "updating xbps itself first"
  if [ "$DRY" = 1 ]; then echo "  would run: xbps-install -yu xbps"; else xbps-install -yu xbps </dev/null || exit 1; fi
fi

say "checking the update for shlib breakage"
round=0
while :; do
  round=$((round + 1))
  resolve_round
  rc=$?
  [ "$rc" = 0 ] && break
  [ "$rc" = 2 ] && exit 1
  if [ "$round" -ge "$MAX_ROUNDS" ]; then warn "gave up after $MAX_ROUNDS rounds"; exit 1; fi
done

if [ "${#HELD_NOW[@]}" -gt 0 ]; then
  b "Frozen for this update (released automatically next run):"
  for p in "${!HELD_NOW[@]}"; do printf '  %-28s %s\n' "$p" "${HELD_NOW[$p]}"; done
fi

if [ "$DRY" = 1 ]; then
  xbps-install -un
  exit 0
fi

if [ "$YES" = 1 ]; then
  xbps-install -yu </dev/null
else
  xbps-install -u
fi
rc=$?
relock_third_party
exit "$rc"
